FROM rust:1.85-bookworm AS builder
WORKDIR /src
COPY . .
RUN cargo build --locked --release --package whalelink-server

FROM debian:bookworm-slim
RUN useradd --system --create-home --uid 10001 whalelink \
    && install -d --owner=whalelink --group=whalelink /var/lib/whalelink
COPY --from=builder /src/target/release/whalelink-server /usr/local/bin/whalelink-server
USER whalelink
EXPOSE 8787
ENTRYPOINT ["/usr/local/bin/whalelink-server"]
