# Copy outside the repository with restrictive file permissions. Never commit real values.
WHALELINK_ADMIN_TOKEN=REPLACE_WITH_A_HIGH_ENTROPY_SECRET
WHALELINK_BIND=127.0.0.1:8787
# Absolute path owned by the service account. Enables restart-safe control-plane state.
WHALELINK_STATE_PATH=/var/lib/whalelink/state.json
WHALELINK_CONFIG=/etc/whalelink/server.toml
# High-entropy room secrets are injected from the protected service environment.
# Each configured room must have its corresponding variable; never write values here.
WHALELINK_ALPHA_NETWORK_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
WHALELINK_BRAVO_NETWORK_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
